# ============================================
# 鞋店電商系統 - 環境變數配置範例
# ============================================
# 複製此文件為 .env 並填入真實值
# 注意：.env 不應該提交到 Git
# ============================================

# ============================================
# 資料庫配置（Neon PostgreSQL）
# ============================================
# 從 Neon 控制台獲取連線字串
# DATABASE_URL 使用連接池（帶 -pooler）
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DIRECT_URL 用於 Prisma Migrate（不帶 -pooler）
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ============================================
# Cloudflare R2 配置（圖片儲存）
# ============================================
# 從 Cloudflare Dashboard > R2 > Manage R2 API Tokens 獲取
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
# 可選：自訂域名（在 R2 Bucket 設定中配置）
R2_PUBLIC_DOMAIN="cdn.yourdomain.com"

# ============================================
# JWT 配置
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ============================================
# Redis 配置（可選，用於快取）
# ============================================
# 生產環境建議使用 Upstash Redis
# REDIS_URL="redis://default:password@your-redis.upstash.io:6379"
REDIS_URL=""

# ============================================
# Next.js 配置
# ============================================
NEXT_PUBLIC_API_URL="https://yourdomain.com"
NEXT_PUBLIC_GRAPHQL_URL="https://yourdomain.com/api/graphql"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="鞋店電商"
NODE_ENV="production"

# ============================================
# LINE Login 配置
# ============================================
# 從 LINE Developers Console 取得
LINE_CHANNEL_ID="your-channel-id"
LINE_CHANNEL_SECRET="your-channel-secret"
LINE_CALLBACK_URL="https://yourdomain.com/auth/line-verify"

# LINE Messaging API（選用）
LINE_MESSAGING_ACCESS_TOKEN="your-messaging-access-token"
LINE_OFFICIAL_ACCOUNT_ID="@your-account-id"

# ============================================
# SMTP 郵件配置
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"

# ============================================
# 藍新金流 NewebPay 配置
# ============================================
NEWEBPAY_MERCHANT_ID="your-merchant-id"
NEWEBPAY_HASH_KEY="your-hash-key"
NEWEBPAY_HASH_IV="your-hash-iv"
NEWEBPAY_MPG_URL="https://core.newebpay.com/MPG/mpg_gateway"
NEWEBPAY_QUERY_URL="https://core.newebpay.com/API/QueryTradeInfo"
NEWEBPAY_NOTIFY_URL="https://yourdomain.com/api/newebpay/notify"
NEWEBPAY_RETURN_URL="https://yourdomain.com/api/newebpay/return"
NEWEBPAY_CLIENT_BACK_URL="https://yourdomain.com/orders"
